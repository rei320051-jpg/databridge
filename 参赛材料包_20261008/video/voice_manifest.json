      "end_sec": 167.08404166666665,
      "scene_start_sec": 161,
      "scene_end_sec": 171,
      "text": "可以查询变化幅度，不等于能够证明变化原因。",
      "tempo": 1.0
    },
    {
      "scene_id": "B15",
      "start_sec": 171.6,
      "end_sec": 179.2585,
      "scene_start_sec": 171,
